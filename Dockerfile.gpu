# GPU backend image for hosts where pip has no CUDA torch wheel
# (ARM/Blackwell, e.g. NVIDIA DGX Spark GB10).
#
# Built by scripts/start.sh with BACKEND_GPU=1 (rebuilds only when
# requirements.txt changes — docker layer cache makes that instant).
# The Python install is fully offline: start.sh pre-downloads every wheel
# with the host pip (reliable network) into .wheels/, and the build below
# installs with --no-index from those local files. Manual build therefore
# needs a populated .wheels/ first (start.sh does this automatically):
#   ./scripts/start.sh  (with BACKEND_GPU=1; stops before the build otherwise)
#
# The base image ships a CUDA torch for its arch; torch is deliberately
# excluded below so requirements.txt can never overwrite it with CPU-only.
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:25.02-py3
FROM ${BASE_IMAGE}

ARG PIP_INDEX_URL
ARG PIP_TRUSTED_HOST
ARG http_proxy
ARG https_proxy
ARG no_proxy

WORKDIR /app

# Unbuffered Python so the exec'd uvicorn log file stays live during boots.
ENV PYTHONUNBUFFERED=1

# System libraries for WeasyPrint (PDF reports): Pango/Cairo stack plus
# DejaVu so PDFs never render tofu boxes. Pure-pip installs cannot
# provide these — this layer is why the image exists.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 \
        libjpeg-dev libopenjp2-7-dev libffi-dev fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
COPY .wheels /tmp/wheels
# Dev/test tooling (pytest, black, ruff, flake8, mypy) has no runtime imports
# and stays out of the image. The pip cache mount survives failed builds so
# flaky networks resume downloads instead of restarting them — without
# bloating the final image the way a kept cache dir would.
RUN --mount=type=cache,target=/root/.cache/pip \
    grep -v -e '^torch==' -e '^--extra-index-url' -e '^#' -e '^[[:space:]]*$' \
        -e '^pytest' -e '^black==' -e '^ruff==' -e '^flake8==' -e '^mypy==' \
        /tmp/requirements.txt > /tmp/requirements-notorch.txt \
    # One interpreter for install and smoke test: bare `pip` and `python3`
    # can resolve to different Pythons (system python vs the conda env
    # shipping CUDA torch) — the exact mismatch that once produced
    # "No module named uvicorn" at boot. Prefer conda's, like start.sh does.
    && if [ -x /opt/conda/bin/python ]; then PY=/opt/conda/bin/python; else PY=python3; fi \
    # Offline install from the host-populated wheelhouse (see start.sh
    # ensure_wheelhouse): no index access, so flaky container DNS cannot
    # break the build. torch stays excluded — the base image's CUDA torch is
    # used as-is, and --no-index fails loudly instead of fetching a CPU
    # wheel over it.
    # shellcheck disable=SC2086: $PY word-splitting is intentional
    # -q hides per-file progress; failures still print and fail the build.
    && $PY -m pip install -q --break-system-packages --no-index --find-links /tmp/wheels \
        -r /tmp/requirements-notorch.txt \
    # Fail the build — not the boot — on broken deps: import everything the
    # backend needs at startup with the SAME interpreter. torch imports
    # without a GPU present; CUDA visibility is verified separately by start.sh.
    && $PY -c "import fastapi, uvicorn, sqlalchemy, jose, yaml, redis, torch, transformers, weasyprint; print('backend deps ok')" \
    && rm -rf /tmp/requirements.txt /tmp/requirements-notorch.txt /tmp/wheels

# Holder model: start.sh mounts the repo at /app and execs uvicorn inside,
# so the image carries deps only — no code, no env, no ports.
CMD ["sleep", "infinity"]
