# GPU backend image for hosts where pip has no CUDA torch wheel
# (ARM/Blackwell, e.g. NVIDIA DGX Spark GB10).
#
# Built by scripts/start.sh with BACKEND_GPU=1 (rebuilds only when
# requirements.txt changes — docker layer cache makes that instant).
# Manual build:
#   docker build --network host -f Dockerfile.gpu -t integritydesk-backend-gpu-img .
#
# The base image ships a CUDA torch for its arch; torch is deliberately
# excluded below so requirements.txt can never overwrite it with CPU-only.
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:25.02-py3
FROM ${BASE_IMAGE}

ARG PIP_INDEX_URL
ARG PIP_TRUSTED_HOST
ARG http_proxy
ARG https_proxy
ARG no_proxy

WORKDIR /app

# System libraries for WeasyPrint (PDF reports): Pango/Cairo stack plus
# DejaVu so PDFs never render tofu boxes. Pure-pip installs cannot
# provide these — this layer is why the image exists.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 \
        libjpeg-dev libopenjp2-7-dev libffi-dev fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
# Dev/test tooling (pytest, black, ruff, flake8, mypy) has no runtime imports
# and stays out of the image. The pip cache mount survives failed builds so
# flaky networks resume downloads instead of restarting them — without
# bloating the final image the way a kept cache dir would.
RUN --mount=type=cache,target=/root/.cache/pip \
    grep -v -e '^torch==' -e '^--extra-index-url' -e '^#' -e '^[[:space:]]*$' \
        -e '^pytest' -e '^black==' -e '^ruff==' -e '^flake8==' -e '^mypy==' \
        /tmp/requirements.txt > /tmp/requirements-notorch.txt \
    && PIP_ARGS="" \
    && if [ -n "$PIP_INDEX_URL" ]; then PIP_ARGS="$PIP_ARGS --index-url $PIP_INDEX_URL"; fi \
    && if [ -n "$PIP_TRUSTED_HOST" ]; then PIP_ARGS="$PIP_ARGS --trusted-host $PIP_TRUSTED_HOST"; fi \
    # shellcheck disable=SC2086: PIP_ARGS word-splitting is intentional here
    # -q hides pip's per-retry warnings (noisy on flaky networks); failures
    # still print their error and fail the build.
    && pip install -q --break-system-packages --retries 10 --timeout 60 $PIP_ARGS \
        -r /tmp/requirements-notorch.txt \
    && rm -f /tmp/requirements.txt /tmp/requirements-notorch.txt

# Fail the build — not the boot — on broken deps: import everything the
# backend needs at startup. torch imports without a GPU present; CUDA
# visibility is verified separately once the backend is up.
RUN python3 -c "import fastapi, uvicorn, sqlalchemy, jose, yaml, redis, torch, transformers, weasyprint; print('backend deps ok')"

# Holder model: start.sh mounts the repo at /app and execs uvicorn inside,
# so the image carries deps only — no code, no env, no ports.
CMD ["sleep", "infinity"]
