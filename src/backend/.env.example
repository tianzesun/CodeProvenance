# =============================================================================
# IntegrityDesk Backend - Environment Variables Template
# =============================================================================
#
# This is a SAFE-TO-COMMIT example file.
#
# Instructions:
#   1. cp src/backend/.env.example src/backend/.env.local
#   2. Replace every <placeholder> with a real value
#
# This is the ONLY environment file the backend reads: src/backend/config/
# settings.py sets env_file=<this directory>/.env.local.  There is no .env,
# no .env.production, and no repo-root .env.local support -- putting one there
# silently does nothing.  The dashboard has its own file:
# src/frontend/.env.local (Next.js only reads env files inside src/frontend/).
#
# Security:
# - Never commit actual secrets to git (.env.local is git-ignored)
# - Use a secrets manager in production (Doppler, AWS Secrets Manager, etc.)
# - Rotate the JWT secret and database credentials regularly
#
# Format notes:
# - Values are plain KEY=value.  A " # comment" suffix is allowed.
# - dict/list settings (LLM_API_KEYS, ENGINE_WEIGHTS, ...) take JSON, e.g.
#     LLM_API_KEYS={"openai": "sk-...", "anthropic": "sk-ant-..."}
# =============================================================================


# ----------------------------------------------------------------------------
# Required (the app refuses to start without these)
# ----------------------------------------------------------------------------
# PostgreSQL connection string. SQLite is explicitly rejected.
DATABASE_URL=<your-database-connection-string>
# Generate a strong random 64+ character string:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_JWT_SECRET=<generate-a-strong-64+-character-random-string>


# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
# Drives the CORS allowlist (localhost/127.0.0.1 variants are added
# automatically) and where password-reset links point.  This is the real CORS
# knob -- there is no CORS_ALLOWED_ORIGINS setting.
FRONTEND_URL=http://localhost:3000

# Used by the webhook worker and background jobs.
REDIS_URL=redis://127.0.0.1:6379/0

# Verbose diagnostic mode.  Keep false in production.
DEBUG_MODE=false


# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------
AUTH_TOKEN_EXPIRE_MINUTES=480
# Set to true only when serving over HTTPS (production).  Keep false for local
# HTTP development, otherwise the session cookie will never be sent.
AUTH_COOKIE_SECURE=false


# ----------------------------------------------------------------------------
# Detection limits & scoring
# ----------------------------------------------------------------------------
DEFAULT_THRESHOLD=0.82
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_JOB=500
BATCH_SIZE=32
# Preset detection domain: code | cs_code | essay | math
DEFAULT_DETECTION_DOMAIN=code
# Engine weights (JSON).  Omit to use the built-in `standard` profile; the
# settings page and course profiles override this at runtime.
# ENGINE_WEIGHTS={"token": 0.12, "winnowing": 0.16, "gst": 0.13, "ast": 0.17, "ngram": 0.10, "graph": 0.15, "embedding": 0.12, "static_rules": 0.05}
# DEFAULT_DETECTION_MODES=["token", "winnowing", "gst", "ast", "ngram", "graph", "embedding", "static_rules"]


# ----------------------------------------------------------------------------
# LLM providers (evidence summaries, rewrite analysis)
# ----------------------------------------------------------------------------
# Provider id from integrations/provider_catalog.py:
#   openai | anthropic | google | xai | mistral | deepseek | groq | openrouter | ollama
LLM_PROVIDER=openai
# Optional secondary provider used when the primary one is unavailable.
LLM_FALLBACK_PROVIDER=
# Per-provider keys / model overrides / base URLs (JSON, all optional).
# An empty model override means "resolve the newest model the vendor offers".
# LLM_API_KEYS={"openai": "", "anthropic": "", "google": ""}
# LLM_MODEL_OVERRIDES={}
# LLM_BASE_URLS={}

# Convenience single-vendor settings (used when the matching LLM_API_KEYS
# entry is absent).  Leave blank to disable.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1


# ----------------------------------------------------------------------------
# Embeddings
# ----------------------------------------------------------------------------
# local_unixcoder (GPU/CPU) | openai | server
EMBEDDING_RUNTIME=local_unixcoder
EMBEDDING_MODEL=microsoft/unixcoder-base
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
# Point these at the optional self-hosted embedding service
# (src/backend/services/embedding_server.py, systemd unit
# integritydesk-embedding) to offload embedding calls.  Leave blank to use the
# local runtime instead.
# EMBEDDING_SERVER_URL=http://127.0.0.1:8001/v1
# EMBEDDING_SERVER_HOST=127.0.0.1
# EMBEDDING_SERVER_PORT=8001
# HOST/PORT below are read ONLY by the embedding server, never by the API.
HOST=0.0.0.0
PORT=8001


# ----------------------------------------------------------------------------
# Email delivery (password reset, review notifications, test sends)
# ----------------------------------------------------------------------------
# console | smtp | sendgrid   (console logs to stdout -- use for development)
EMAIL_BACKEND=console
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@integritydesk.com
EMAIL_USE_TLS=true
# Required only when EMAIL_BACKEND=sendgrid.
SENDGRID_API_KEY=


# ----------------------------------------------------------------------------
# External services (optional)
# ----------------------------------------------------------------------------
# MOSS: https://theory.stanford.edu/~aiken/moss/  (registration required)
MOSS_USER_ID=
# Third-party AI detectors (used as corroborating signals).
GPTZERO_API_KEY=
GRAMMARLY_API_KEY=

# Public source scanning (GitHub / Stack Overflow provenance checks).
# Enable per-workspace in admin settings (Public Source Scanning); these keys
# only widen API quota.
#   GITHUB_TOKEN:   https://github.com/settings/tokens (classic, no scopes)
#   STACKEXCHANGE:  https://stackexchange.com/users/manage-your-apps/stack-exchange-api
#                   Stack Overflow works keyless at ~300 requests/day per IP.
GITHUB_TOKEN=
# GITHUB_API_TOKEN is accepted as an alias for GITHUB_TOKEN.
STACKEXCHANGE_API_KEY=
SOURCE_SCAN_ENABLED=false
# SOURCE_SCAN_SITES=["https://github.com", "https://stackoverflow.com"]


# ----------------------------------------------------------------------------
# Webhooks, audit & compliance
# ----------------------------------------------------------------------------
# Default callback URL for completed jobs (jobs may override per request).
WEBHOOK_URL=
AUDIT_LOG_LEVEL=INFO
AUDIT_RETENTION_DAYS=365


# ----------------------------------------------------------------------------
# Database connection pool (read by src/backend/config/database.py)
# ----------------------------------------------------------------------------
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40


# ----------------------------------------------------------------------------
# Removed -- documented here so you know they do nothing
# ----------------------------------------------------------------------------
# These used to appear in this template but no code reads them.  Removing
# them is deliberate: setting them had no effect.
#
#   APP_NAME, APP_ENV, DEBUG       -> never read
#   BACKEND_URL                    -> frontend-only; set it in
#                                     src/frontend/.env.local
#   CORS_ALLOWED_ORIGINS           -> use FRONTEND_URL above
#   LOG_LEVEL                      -> logging level is hardcoded to INFO
#   SENTRY_DSN                     -> no Sentry integration exists
#   UPLOAD_DIR                     -> uploads are always <repo>/uploads
#   MAX_UPLOAD_SIZE_MB             -> use MAX_FILE_SIZE_MB
#   JWT_ALGORITHM                  -> hardcoded to HS256
#   JWT_ACCESS_TOKEN_EXPIRE_MINUTES, JWT_REFRESH_TOKEN_EXPIRE_DAYS
#                                  -> use AUTH_TOKEN_EXPIRE_MINUTES
#   RQ_REDIS_URL                   -> RQ is not used; use REDIS_URL

# ----------------------------------------------------------------------------
# Release Security Policy
# ----------------------------------------------------------------------------
# Public API docs (/docs, /redoc, /openapi.json) are disabled by default because
# the schema describes every endpoint in the system. Enable only for a trusted,
# internal audience.
EXPOSE_API_DOCS=false

# Uploads, AI review and benchmarking require a dashboard session or an API key.
# Set to true ONLY for local demos that need anonymous access.
ALLOW_ANONYMOUS_ANALYSIS=false

# Seeded development/demo API keys are created only when BOTH DEBUG_MODE and
# ALLOW_DEV_API_KEYS are true. Leave both false in any deployed environment.
ALLOW_DEV_API_KEYS=false
