# =============================================================================
# CodeProvenance Backend - Environment Variables Template
# =============================================================================
#
# This is a SAFE-TO-COMMIT example file.
#
# Instructions:
#   1. Copy this file to `.env.local` (for local development)
#   2. Or copy it to `.env` / `.env.production` for deployment
#   3. Replace all <placeholder> values with real configuration
#
# Security:
# - Never commit actual secrets to git
# - Use a secrets manager in production (Doppler, AWS Secrets Manager, etc.)
# - Rotate JWT secrets and database credentials regularly
# =============================================================================


# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_NAME=CodeProvenance Backend
APP_ENV=development                  # development | staging | production
DEBUG=true                           # Set to false in production


# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3000


# ----------------------------------------------------------------------------
# Security (REQUIRED - Generate strong random values)
# ----------------------------------------------------------------------------
AUTH_JWT_SECRET=<generate-a-strong-64+-character-random-string>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true only when serving over HTTPS (production).  Keep false for local
# HTTP development, otherwise the session cookie will never be sent.
AUTH_COOKIE_SECURE=false


# ----------------------------------------------------------------------------
# Database (REQUIRED)
# ----------------------------------------------------------------------------
DATABASE_URL=<your-database-connection-string>

# Connection pool settings (adjust based on expected load)
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40


# ----------------------------------------------------------------------------
# Cache & Background Jobs
# ----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
RQ_REDIS_URL=redis://127.0.0.1:6379/0


# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000


# ----------------------------------------------------------------------------
# External Services (Optional)
# ----------------------------------------------------------------------------
# AI / Embedding Services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_SERVER_URL=http://127.0.0.1:8001/v1
EMBEDDING_SERVER_HOST=127.0.0.1
EMBEDDING_SERVER_PORT=8001

# Plagiarism Detection Tools (Optional)
MOSS_USER_ID=
GPTZERO_API_KEY=
GRAMMARLY_API_KEY=


# ----------------------------------------------------------------------------
# Logging & Monitoring (Optional)
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
SENTRY_DSN=


# ----------------------------------------------------------------------------
# File Storage
# ----------------------------------------------------------------------------
UPLOAD_DIR=./uploads                 # Consider using an absolute path in production
MAX_UPLOAD_SIZE_MB=100
