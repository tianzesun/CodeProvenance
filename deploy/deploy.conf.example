# =============================================================================
# IntegrityDesk Deployment Configuration
# =============================================================================
# Copy this file to deploy.conf (git-ignored) and edit values for the server.
#   cp deploy/deploy.conf.example deploy.conf
# Then run:  sudo bash deploy/setup.sh
#
# NOTE: deploy.conf contains secrets (DATABASE_URL, API keys) and must NOT be
# committed to git. It is already listed in .gitignore.

# --- Web server (apache | nginx) ----------------------------------------------
# Apache is the default. If you prefer nginx, set WEB_SERVER=nginx (an nginx
# template is also included under deploy/nginx/).
WEB_SERVER=apache

# --- Domain / TLS -------------------------------------------------------------
# Public domain of the app (used for the vhost + certbot). No scheme, e.g.:
# APP_DOMAIN=integritydesk.example.com
APP_DOMAIN=integritydesk.example.com
# Email for Let's Encrypt certificate expiry notices.
CERTBOT_EMAIL=admin@example.com

# --- Ports (all bound to 127.0.0.1 behind the web server) ----------------------
DASHBOARD_PORT=3000
BACKEND_PORT=8000
EMBEDDING_PORT=8001

# --- Database (REQUIRED - managed Postgres e.g. Neon/RDS) ---------------------
# Must be a PostgreSQL connection string. The backend explicitly rejects SQLite.
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# --- Cache / Background jobs ---------------------------------------------------
# Redis is used by the webhook worker (background delivery). Optional if you
# do not need webhooks, otherwise provide a reachable Redis URL.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Run-as user ----------------------------------------------------------------
# System account that runs the systemd services. setup.sh creates it if missing.
RUN_USER=integritydesk
# Absolute path where the repository lives on the server.
APP_DIR=/home/tsun/projects/CodeProvenance

# --- Python / venv ---------------------------------------------------------------
# Set to 1 to skip venv creation and pip install (you already have a venv).
# When enabled, setup.sh uses the existing venv at $APP_DIR/venv.
SKIP_VENV=0

# --- Embedding / ML stack --------------------------------------------------------
# We deliberately keep the deployment lean: no torch/sentence-transformers.
# Leave EMBEDDING_SERVER_URL empty so the app falls back to OpenAI or skips
# the embedding engine entirely. Set OPENAI_API_KEY if you want OpenAI embeddings.
OPENAI_API_KEY=
# If you later install the ML stack, uncomment:
# EMBEDDING_SERVER_URL=http://127.0.0.1:8001/v1
# EMBEDDING_SERVER_HOST=127.0.0.1
# EMBEDDING_SERVER_PORT=8001

# --- Optional external services -------------------------------------------------
# MOSS_USER_ID=
# GPTZERO_API_KEY=
# GRAMMARLY_API_KEY=
