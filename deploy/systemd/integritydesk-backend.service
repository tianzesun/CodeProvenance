[Unit]
Description=IntegrityDesk Backend API (FastAPI/uvicorn)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@APP_DIR@/src/backend/.env.local
Environment=PYTHONUNBUFFERED=1
ExecStart=@APP_DIR@/venv/bin/python -m uvicorn src.backend.api.server:app --host 127.0.0.1 --port @BACKEND_PORT@
Restart=always
RestartSec=5
# Prevent timeouts on model warmups / heavy analysis
TimeoutStartSec=300
# Fail fast if the app did not bind: verify it is serving before declaring up.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 60); do if curl -fsS http://127.0.0.1:@BACKEND_PORT@/health >/dev/null 2>&1; then exit 0; fi; sleep 1; done; exit 1'

[Install]
WantedBy=multi-user.target
