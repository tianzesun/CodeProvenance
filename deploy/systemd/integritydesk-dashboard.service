[Unit]
Description=IntegrityDesk Dashboard (Next.js)
After=network.target integritydesk-backend.service
Wants=integritydesk-backend.service

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_USER@
WorkingDirectory=@APP_DIR@/src/frontend
Environment=NODE_ENV=production
Environment=PORT=@DASHBOARD_PORT@
Environment=HOST=127.0.0.1
Environment=API_URL=http://127.0.0.1:@BACKEND_PORT@
Environment=NEXT_PUBLIC_API_URL=http://127.0.0.1:@BACKEND_PORT@
ExecStart=@APP_DIR@/src/frontend/node_modules/.bin/next start --hostname 127.0.0.1 --port @DASHBOARD_PORT@
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
